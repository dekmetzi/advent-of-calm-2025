{
  "$schema": "https://calm.finos.org/release/1.1/meta/calm.json",
  "unique-id": "metrics-collection-system",
  "name": "Metrics Collection System",
  "description": "A metrics collection system that ingests and stores time-series metrics and permits querying for analysis and alerting.",
  "metadata": {
    "version": "1.0.0",
    "owner": "dekmetzi@users.noreply.github.com",
    "created": "2025-12-06",
    "description": "Metrics system architecture for Advent of CALM learning",
    "tags": ["learning", "metrics", "microservices"],
    "status": "draft"
  },
  "nodes": [
    {
      "unique-id": "metrics-store",
      "node-type": "database",
      "name": "Metrics Store",
      "description": "Time-series database that stores metrics and exposes query APIs for analytics and alerting.",
      "metadata": {
        "storage-type": "time-series",
        "protocols": ["http", "grpc"],
        "retention-days": 90
      }
    }
    ,
    {
      "unique-id": "metrics-blob-storage",
      "node-type": "data-asset",
      "name": "Metrics Blob Storage",
      "description": "Object storage that holds blobified time-series segments for archival and bulk analysis.",
      "metadata": {
        "storage-type": "object-storage",
        "provider": "s3-compatible",
        "region": "us-east-1",
        "encryption": "AES256",
        "retention-days": 365
      }
      ,
      "interfaces": [
        {
          "unique-id": "metrics-blob-api",
          "protocol": "http",
          "host": "obj1.example.com",
          "port": 443,
          "bucket": "metrics-blobs"
        }
      ]
    }
    ,
    {
      "unique-id": "end-user",
      "node-type": "actor",
      "name": "End User",
      "description": "An end user or customer who uses the metrics collection service.",
      "metadata": {
        "role": "customer",
        "channel": "web"
      }
    }
    ,
    {
      "unique-id": "metrics-service",
      "node-type": "service",
      "name": "Metrics Ingestion Service",
      "description": "Service responsible for ingesting and processing incoming metrics before storage.",
      "metadata": {
        "tech-owner": "Observability Team",
        "repository": "https://github.com/example/metrics-service",
        "deployment-type": "container",
        "sla-tier": "tier-2",
        "runtime": "go",
        "replicas": 3
      }
      ,
      "interfaces": [
        {
          "unique-id": "metrics-ingest-api",
          "protocol": "HTTPS",
          "host": "api.example.com",
          "port": 443,
          "path": "/api/v1"
        }
      ]
    }
    ,
    {
      "unique-id": "metrics-system",
      "node-type": "system",
      "name": "Metrics Collection System",
      "description": "Top-level system boundary that contains the metrics ingestion service and the time-series database.",
      "metadata": {
        "owner": "Observability Team",
        "criticality": "medium"
      }
    }
  ],
  "relationships": [
    {
      "unique-id": "metrics-store-to-blob-storage",
      "description": "Metrics Store connects to blob storage for archiving time-series blobs.",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "metrics-store"
          },
          "destination": {
            "node": "metrics-blob-storage"
          }
        }
      },
      "metadata": {
        "latency-sla": "< 100ms",
        "monitoring": true,
        "circuit-breaker": true
      },
      "protocol": "HTTPS"
    },
    {
      "unique-id": "end-user-interacts-with-metrics-store",
      "description": "End user interacts with the Metrics Store service for querying and visualization.",
      "relationship-type": {
        "interacts": {
          "actor": "end-user",
          "nodes": ["metrics-store"]
        }
      }
    }
    ,
    {
      "unique-id": "metrics-system-composed-of",
      "description": "Metrics system is composed of the ingestion service and the time-series database.",
      "relationship-type": {
        "composed-of": {
          "container": "metrics-system",
          "nodes": ["metrics-service", "metrics-store"]
        }
      }
    }
  ]
}
